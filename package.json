{
  "name": "@blink-internal-tools/strategy-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "戦略マップ（Google Workspace SSO / D1保存 / Jira連携）— Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply strategy-map --local",
    "db:migrate:remote": "wrangler d1 migrations apply strategy-map --remote",
    "maps": "node scripts/maps.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
