# ローカル開発用（cp .dev.vars.example .dev.vars）。.dev.vars は gitignore 済み。

# --- Google Workspace SSO ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# セッションCookieの署名鍵（openssl rand -hex 32）
SESSION_SECRET=change-me-to-a-long-random-hex

# --- Jira（MCPハブと同じ値でOK） ---
ATLASSIAN_EMAIL=you@blink-consulting.jp
ATLASSIAN_API_TOKEN=xxxxxxxx

# --- スクリプト/Claude 用の APIキー（任意。未設定なら X-API-Key 認証は無効） ---
API_KEY=change-me

# --- ローカル専用：Googleログインを省略して、このユーザーとして扱う ---
# localhost / 127.0.0.1 へのアクセス時だけ有効。本番には絶対に登録しないこと。
DEV_USER_EMAIL=you@blink-consulting.jp
